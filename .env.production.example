# =====================================================================
#  MODÈLE DE CONFIGURATION — PRODUCTION (cPanel / O2switch)
#  1. Copier ce fichier en « .env » sur le serveur
#  2. Remplacer les valeurs entre <...> par les vraies
#  3. Générer la clé :  php artisan key:generate
# =====================================================================

APP_NAME="Université de Kara — Dématérialisation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<votre-domaine-ou-sous-domaine>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Journaux (production : niveau réduit) ──────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données MySQL (créée dans cPanel > Bases de données MySQL)
# Sur cPanel, le nom réel est préfixé par votre compte, ex : ukcompte_demat
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<compte>_dematerialisation
DB_USERNAME=<compte>_demat
DB_PASSWORD=<mot_de_passe_fort>

# ── Sessions / cache / file d'attente : fichiers (OK en mutualisé) ─
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── E-mail : compte créé dans cPanel > Comptes de messagerie ───────
MAIL_MAILER=smtp
MAIL_HOST=<mail.votre-domaine>
MAIL_PORT=465
MAIL_USERNAME=<no-reply@votre-domaine>
MAIL_PASSWORD=<mot_de_passe_email>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@<votre-domaine>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
